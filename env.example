# Скопируй в `.env` и заполни. `.env` загружается в config.py при импорте
# (load_dotenv с override=False — реальный shell-env приоритетнее).

# === Обязательно ===
# Ключ Cerebras для LLM-классификации ТЗ. Без него анализ молча скипается
# (см. classify/llm.py: analyze_and_save обёрнут в try/except).
CEREBRAS_API_KEY=

# Секрет подписи cookie-сессии (openssl rand -hex 32). ОБЯЗАТЕЛЕН на проде:
# web и worker откажутся стартовать с дефолтом, кроме dev-режима GZ_NO_AUTH=1
# (иначе подделка cookie = обход auth). При рестарте без него все сессии слетают.
GZ_SECRET_KEY=

# === Автоподача заявок (обязательно ТОЛЬКО если включаете автоподачу) ===
# Мастер-ключ KeyVault (base64 от 32 байт): шифрует чужие .p12/пароли/PIN
# клиентов. Сгенерировать:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Без него любое обращение к Vault падает. В проде — из KMS/HSM.
# GZ_VAULT_MASTER_KEY=
# Токен канала Linux→Windows-agent (POST /run, X-Agent-Token). Обязателен на
# обеих сторонах при боевой автоподаче — без него agent не стартует, диспетчер
# не шлёт секреты. Должен совпасть с GZ_AGENT_TOKEN на Windows-узле.
# GZ_AUTOSUBMIT_AGENT_TOKEN=

# === Опционально ===
# Модель Cerebras. По умолчанию — gpt-oss-120b.
# GZ_LLM_MODEL=gpt-oss-120b

# Локальный запуск UI без Basic Auth. Любое значение != "1" включает auth.
GZ_NO_AUTH=1

# Если auth включён — креды для входа. По умолчанию admin/admin.
# GZ_USER=admin
# GZ_PASSWORD=admin

# Переопределить URL БД. По умолчанию sqlite:///data/goszakup.sqlite.
# Используется тестами (tmp-файл) и в будущем — для переезда на Postgres.
# GZ_DATABASE_URL=

# === Официальный API goszakup / OWS (опционально, но сильно ускоряет) ===
# Bearer-токен унифицированных сервисов ows.goszakup.gov.kz (выдаёт ЦЭФ по
# заявке, срок — 1 год). Есть токен → листинг/детали/файлы идут через JSON
# API (~30-50× быстрее HTML), HTML-скрейпер остаётся фолбэком. Нет — прежний
# HTML-путь.
# GZ_OWS_TOKEN=
# Дата истечения токена (YYYY-MM-DD) — health-check предупредит за 14 дней.
# Важно: истёкший токен OWS маскирует под 404, сам по себе он не виден.
# GZ_OWS_TOKEN_EXPIRES=
# Пауза между запросами к OWS, сек (дефолт 1.0; лимит API не заявлен).
# GZ_API_DELAY=1.0

# === Telegram-уведомления (опционально) ===
# Токен бота (@BotFather). Без него уведомления о матчах тихо выключены.
# GZ_TELEGRAM_BOT_TOKEN=
# Секрет вебхука для кнопки «Подробнее» в уведомлении (openssl rand -hex 32).
# Без него POST /telegram/webhook выключен. После добавления — один раз
# зарегистрировать вебхук: `python -m goszakup.cli telegram-set-webhook`.
# GZ_TELEGRAM_WEBHOOK_SECRET=

# === Sentry (опционально) ===
# Если задан — uvicorn/CLI/daily будут слать туда исключения и WARNING'и.
# Без DSN — никакой телеметрии, всё локально.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=  # можно прокидывать git SHA на деплое

# Скопируй в `.env` и заполни. `.env` загружается в config.py при импорте
# (load_dotenv с override=False — реальный shell-env приоритетнее).

# === Обязательно ===
# Ключ Cerebras для LLM-классификации ТЗ. Без него анализ молча скипается
# (см. classify/llm.py: analyze_and_save обёрнут в try/except).
CEREBRAS_API_KEY=

# === Опционально ===
# Модель Cerebras. По умолчанию — gpt-oss-120b.
# GZ_LLM_MODEL=gpt-oss-120b

# Локальный запуск UI без Basic Auth. Любое значение != "1" включает auth.
GZ_NO_AUTH=1

# Если auth включён — креды для входа. По умолчанию admin/admin.
# GZ_USER=admin
# GZ_PASSWORD=admin

# Переопределить URL БД. По умолчанию sqlite:///data/goszakup.sqlite.
# Используется тестами (tmp-файл) и в будущем — для переезда на Postgres.
# GZ_DATABASE_URL=

# === Telegram-уведомления (опционально) ===
# Токен бота (@BotFather). Без него уведомления о матчах тихо выключены.
# GZ_TELEGRAM_BOT_TOKEN=
# Секрет вебхука для кнопки «Подробнее» в уведомлении (openssl rand -hex 32).
# Без него POST /telegram/webhook выключен. После добавления — один раз
# зарегистрировать вебхук: `python -m goszakup.cli telegram-set-webhook`.
# GZ_TELEGRAM_WEBHOOK_SECRET=

# === Sentry (опционально) ===
# Если задан — uvicorn/CLI/daily будут слать туда исключения и WARNING'и.
# Без DSN — никакой телеметрии, всё локально.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=  # можно прокидывать git SHA на деплое

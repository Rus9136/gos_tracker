# Окружение и креды
.env
.env.*
!env.example

# Виртуальное окружение и кеши Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# macOS / IDE
.DS_Store
.idea/
.vscode/

# Локальные настройки Claude Code
.claude/

# Данные приложения (SQLite, документы, логи прогонов)
data/goszakup.sqlite
data/goszakup.sqlite-*
data/docs/
data/logs/
data/org_runs/
data/backups/
data/*.lock

# Логи и одноразовые CSV-выгрузки в корне
*.log
*.csv

# HAR-трейсы разведки ЭЦП-протокола goszakup — содержат пароли портала и
# реальные сертификаты (см. TENDER_ECP_SIGNING_GUIDE.md, разделы 2.4/6.1).
# Никогда не коммитить; удалять после анализа.
*.har

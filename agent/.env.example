# Пример окружения Windows submit-agent. Скопировать в .env и заполнить.
# Все секреты — только здесь, не в коде. Файл .env не коммитить.

# --- сервер агента (слушать на tailnet, не на 0.0.0.0) ---
GZ_AGENT_HOST=127.0.0.1
GZ_AGENT_PORT=8799
# Токен, которым Linux авторизуется в POST /run (должен совпасть с
# GZ_AUTOSUBMIT_AGENT_TOKEN на Linux). Сгенерировать: openssl rand -hex 32
GZ_AGENT_TOKEN=

# --- отчёт обратно на Linux ---
# Ingest-эндпоинт Linux по адресу в приватной сети Tailscale.
GZ_LINUX_INGEST_URL=http://<linux-tailscale-ip>:8765/autosubmit/result
# Должен совпасть с GZ_AUTOSUBMIT_INGEST_TOKEN на Linux.
GZ_AUTOSUBMIT_INGEST_TOKEN=

# --- goszakup / локальные провайдеры ---
GZ_GOSZAKUP_BASE=https://v3bl.goszakup.gov.kz
GZ_NCALAYER_WS=wss://127.0.0.1:13579/
GZ_TUMAR_WS=wss://127.0.0.1:6127/tumarcsp/
# Заголовок нативного окна цены Tumar — ЗАПОЛНИТЬ ИЗ RECON (README шаг 4).
GZ_TUMAR_WINDOW_TITLE=

# --- браузер ---
# 0 = реальный браузер (боевой режим, нужны нативные окна). 1 = headless (отладка).
GZ_AGENT_HEADLESS=0
GZ_AGENT_WARMUP_MARGIN=120
